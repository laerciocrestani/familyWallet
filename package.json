{
  "name": "family-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --env-file=.env --experimental-strip-types --disable-warning=ExperimentalWarning --watch server/index.ts\" \"vite\"",
    "start": "NODE_ENV=production node --env-file=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test server/app.test.ts src/lib/period.test.ts src/lib/cards.test.ts src/lib/card-share.test.ts src/lib/categories.test.ts src/lib/boxes.test.ts src/lib/box-items.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
